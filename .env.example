# CutClaw secrets — copy this file to .env and fill in real values.
# .env is gitignored; NEVER put real keys in src/config.py or src/api_pool.json
# committed to git.

# VLM for video/image analysis (config: VIDEO_ANALYSIS_API_KEY)
VIDEO_ANALYSIS_API_KEY=

# LLM for audio captioning/structure analysis (config: AUDIO_LITELLM_API_KEY)
AUDIO_LITELLM_API_KEY=

# LLM for Screenwriter/Editor/Selector agents (config: AGENT_LITELLM_API_KEY)
AGENT_LITELLM_API_KEY=

# Immich integration — asset.read/view/download + search permissions only
IMMICH_API_KEY=
